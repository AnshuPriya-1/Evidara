# Copy to .env and fill in. Leave CLOUDINARY_URL empty to run in local demo mode.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Only set these after `npm run check` shows the add-on works on your account
AI_TAGGING=            # e.g. google_tagging
AI_CAPTIONING=0        # 1 to request Cloudinary auto-captions
PORT=3000
